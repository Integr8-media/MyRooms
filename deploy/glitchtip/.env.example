# Copy to .env (never commit it). Generate secrets with: openssl rand -hex 32
GLITCHTIP_DOMAIN=https://errors.example.com
GLITCHTIP_SECRET_KEY=
GLITCHTIP_DB_PASSWORD=
GLITCHTIP_FROM_EMAIL=errors@example.com
# SMTP for alert emails (same server as Supabase's SMTP is fine), or consolemail:// for none.
GLITCHTIP_EMAIL_URL=consolemail://
