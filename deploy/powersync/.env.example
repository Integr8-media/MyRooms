# Copy to .env on the VPS (never commit the real file).

# Direct connection to the Supabase Postgres container as the powersync_role
# (created by the migrations; password set once, see deploy/README.md).
PS_SOURCE_DB_URI=postgresql://powersync_role:CHANGE_ME@db:5432/postgres

# Password for PowerSync's own storage database. Generate: openssl rand -hex 24
PS_STORAGE_DB_PASSWORD=CHANGE_ME

# Supabase Auth public keys (through the Supabase gateway on the Docker network).
PS_SUPABASE_JWKS_URI=http://kong:8000/auth/v1/.well-known/jwks.json

# Token for PowerSync's admin API. Generate: openssl rand -hex 32
PS_ADMIN_API_TOKEN=CHANGE_ME

# Name of the Supabase stack's Docker network (check with: docker network ls)
SUPABASE_DOCKER_NETWORK=supabase_default
