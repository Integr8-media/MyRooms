# Copy to .env.local and fill in. EXPO_PUBLIC_* values are bundled into the app (never put secrets here).

# Supabase API: the VPS (https://api.<your-domain>) or local CLI (http://127.0.0.1:54321).
EXPO_PUBLIC_SUPABASE_URL=https://api.example.com
# Publishable key (VPS: `sh run.sh secrets` in the Supabase folder; local: printed by `npx supabase start`).
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# PowerSync service: the VPS (https://sync.<your-domain>).
EXPO_PUBLIC_POWERSYNC_URL=https://sync.example.com
# Public web app URL. Password-reset and invitation emails link here when sent from the Windows app.
EXPO_PUBLIC_APP_URL=https://app.example.com
# Optional error tracking: the DSN of a GlitchTip (self-hosted, deploy/glitchtip) or Sentry project. Empty = off.
EXPO_PUBLIC_SENTRY_DSN=
# Environment name on error reports (development, pilot, production).
EXPO_PUBLIC_APP_ENV=development
