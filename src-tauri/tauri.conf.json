{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "MyRooms",
  "version": "../package.json",
  "identifier": "com.integr8media.myrooms",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:8081",
    "beforeDevCommand": "npm run web -- --port 8081",
    "beforeBuildCommand": "npm run build:web"
  },
  "app": {
    "windows": [
      {
        "title": "MyRooms",
        "width": 1280,
        "height": 800,
        "minWidth": 360,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "integr8 media",
    "shortDescription": "MyRooms — gaming center management",
    "category": "Business",
    "copyright": "© 2026 integr8 media",
    "windows": {
      "nsis": {
        "languages": ["English", "Arabic"],
        "displayLanguageSelector": true,
        "installMode": "currentUser"
      }
    }
  }
}
